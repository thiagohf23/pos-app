# ─── Application ────────────────────────────────────
APP_NAME="POS App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ─── Port Customization ──────────────────────────────
APP_PORT=8000
VITE_PORT=5173
MAILPIT_PORT=8025

# ─── Database ───────────────────────────────────────
# SQLite (default - zero config)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pos_app
# DB_USERNAME=root
# DB_PASSWORD=

# MySQL (run: docker compose --profile mysql up -d)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pos_app
# DB_USERNAME=root
# DB_PASSWORD=password

# PostgreSQL (run: docker compose --profile postgres up -d)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=pos_app
# DB_USERNAME=postgres
# DB_PASSWORD=password

# ─── Session / Cache / Queue ────────────────────────
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# ─── Mail (Mailpit - run: docker compose up -d) ────
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@pos-app.com"
MAIL_FROM_NAME="${APP_NAME}"
